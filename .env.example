
# Configuración General de la Aplicación

APP_NAME="Sistema Municipal Yau - Trámites y Selección CV"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Orígenes permitidos para CORS (separados por comas, sin espacios)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# Base de Datos (PostgreSQL en Docker)

POSTGRES_USER=yau_admin
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=yau_municipalidad_db
POSTGRES_HOST=db
POSTGRES_PORT=5432


# Seguridad y Autenticación (JWT)

JWT_SECRET_KEY=generar_clave_secreta_larga_y_segura_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# Rutas de Almacenamiento y Machine Learning

UPLOAD_DIR=storage/uploads
ML_ARTIFACTS_DIR=app/ml/artifacts

# Notificaciones por Correo (SMTP)

# En desarrollo en false para registrar alertas sin bloquear por SMTP
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@muniyau.gob.pe